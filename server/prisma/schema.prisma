generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Ticket {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(120)
  description   String
  customerEmail String
  priority      Priority
  status        Status   @default(OPEN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([customerEmail])
}